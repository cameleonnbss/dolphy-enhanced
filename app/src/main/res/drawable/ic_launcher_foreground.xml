<?xml version="1.0" encoding="utf-8"?>
<!--
  Dolphy Enhanced launcher foreground: a signal source emitting two arcs.
  Reads as "wireless / radio / RF" at 48 px, which is what the app is about.
  Adaptive-icon safe zone is the inner 72x72 of the 108x108 canvas.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- outer arc -->
    <path
        android:pathData="M54,36 A26,26 0 0,1 80,62"
        android:strokeColor="#FF00E5C0"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- inner arc -->
    <path
        android:pathData="M54,44 A16,16 0 0,1 70,60"
        android:strokeColor="#FF00E5C0"
        android:strokeAlpha="0.75"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- emitter -->
    <path
        android:pathData="M54,49 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:fillColor="#FFFFFFFF" />
    <path
        android:pathData="M54,49 m-3.5,0 a3.5,3.5 0 1,0 7,0 a3.5,3.5 0 1,0 -7,0"
        android:fillColor="#FF2B1055" />
</vector>
